{
  "permissions": {
    "allow": [
      "Bash(ruby tools/*)",
      "Bash(ruby -Itools/test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/run_debug.ps1*)"
    ],
    "deny": [
      "Edit(**/*.rxdata)",
      "Write(**/*.rxdata)",
      "Edit(**/*.dat)",
      "Write(**/*.dat)",
      "Edit(Data/Scripts/**)",
      "Write(Data/Scripts/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\guard.ps1\""
          }
        ]
      }
    ]
  }
}
