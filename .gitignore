# 게임 레포용 .gitignore (Maruno 엔진 레포 버전에서 변경: Plugins/·맵 데이터를 추적)

# --- 컴파일 산출물 (PBS / Plugins 에서 재생성) ---
Data/*.dat
# 코어 텍스트는 엔진 레포가 추적하는 파일. messages_game.dat 는 컴파일 산출물이라 무시
!Data/messages_core.dat
Data/PluginScripts.rxdata
Data/ScriptsBackup.rxdata
Data/debuglog.txt
Data/Backup/

# --- 런타임/로그 ---
errorlog.txt
logs/
Screenshots/
RGSS*.dll
*.tmp
~*

# --- 개인 설정 / 에디터 ---
CLAUDE.local.md
.claude/settings.local.json
.vscode/
*.code-workspace
.idea/
*.mkproj

# --- OS ---
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- 외부 원본에서 추출한 작업 파일 (tools/pokemanager 로 재생성) ---
import/

# --- 배포 빌드 ---
dist/
Release/

# 추적 대상 (무시하지 말 것):
# Data/Map*.rxdata, MapInfos/Tilesets/System/CommonEvents/Animations.rxdata,
# Data/Scripts/, Data/Scripts.rxdata(로더), Plugins/, PBS/, Game.ini, Game.rxproj
# Graphics/, Audio/ 는 LFS 설정(.gitattributes) 후 추적
